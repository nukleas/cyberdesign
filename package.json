{
  "name": "cyberdesign-monorepo",
  "private": true,
  "description": "Monorepo for cyberdesign (CSS) and react-cyberdesign (React + Storybook)",
  "license": "MIT",
  "author": "Nader Heidari <nukleas2001@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nukleas/cyberdesign.git"
  },
  "packageManager": "pnpm@11.2.2",
  "scripts": {
    "build": "pnpm -r --filter cyberdesign --filter react-cyberdesign run build",
    "build:css": "pnpm --filter cyberdesign run build",
    "build:react": "pnpm --filter react-cyberdesign run build",
    "dev": "pnpm --filter cyberdesign run dev",
    "storybook": "pnpm --filter react-cyberdesign run storybook",
    "build-storybook": "pnpm --filter react-cyberdesign run build-storybook",
    "typecheck": "pnpm --filter react-cyberdesign run typecheck",
    "demo": "pnpm --filter cyberdesign run demo"
  },
  "engines": {
    "node": ">=20"
  }
}
